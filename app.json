{
  "expo": {
    "version": "1.0.0",
    "name": "HighReels",
    "slug": "highreels",
    "scheme": "highreels",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "web",
      "ios",
      "android"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.highreels",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.highreels"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./src/assets/splash.png"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88a2f948-4ba4-4eb1-a1e0-5ce65ead8f71"
      }
    },
    "owner": "joss-technologies"
  }
}
