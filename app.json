{
  "expo": {
    "version": "1.0.0",
    "name": "HighReels",
    "slug": "highreels",
    "scheme": "highreels",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "platforms": ["web", "ios", "android"],
    "experiments": {"typedRoutes": true, "tsconfigPaths": true},
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.highreels"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.highreels"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/splash.png"
        }
      ]
    ],
    "extra": {"router": {}, "eas": {"projectId": "d8354511-ea55-4eaf-98c1-a7f934f25a77"}},
    "owner": "joss-tech"
  }
}
